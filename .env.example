# Copy to .env and fill in. Alternatively run `ant auth login` and leave this unset --
# the Anthropic SDK resolves a stored profile automatically.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown).
JARVIS_MODEL=claude-opus-5-5
JARVIS_EFFORT=medium
JARVIS_MAX_TOKENS=16000

# Directory the filesystem tools are allowed to read. Defaults to the current directory.
JARVIS_WORKSPACE=.
