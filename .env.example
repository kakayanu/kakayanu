# Required for the Claude decision loop
ANTHROPIC_API_KEY=

# Required for --broker alpaca (paper trading keys from https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Required for --broker ccxt --exchange binance (testnet keys)
BINANCE_API_KEY=
BINANCE_SECRET=

# Risk guardrails (deterministic, enforced regardless of what the agent decides)
MAX_POSITION_PCT=0.10
MAX_ORDER_NOTIONAL=5000
MAX_DAILY_LOSS_PCT=0.03
MAX_OPEN_POSITIONS=10
ALLOWED_SYMBOLS=AAPL,MSFT,GOOGL
